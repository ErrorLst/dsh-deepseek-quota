{
  "name": "@dsh-external/dsh-deepseek-quota",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle plugin: real-time DeepSeek API balance in the sidebar footer",
  "keywords": [
    "dsh",
    "deepseek",
    "quota",
    "balance",
    "plugin",
    "cordis"
  ],
  "author": "@dsh-external/dsh-deepseek-quota contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErrorLst/dsh-deepseek-quota.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/index.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
